# ============================================================================
# MEDICONTROL - Variables del entorno Docker (compose.yaml)
#
# 1. Copiá este archivo como .env en la misma carpeta (la raíz del repositorio).
# 2. Completá las tres claves marcadas como OBLIGATORIA con valores nuevos y al azar.
# El .env está en .gitignore: nunca lo subas al repositorio.
#
# Para generar un valor al azar en PowerShell (60 caracteres; ejecutalo una vez por clave):
#   $b = New-Object byte[] 30; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
#
# Si falta una obligatoria, "docker compose up" se detiene y dice cuál es. Usá solo letras
# y números en las claves para no tener problemas con caracteres especiales.
# ============================================================================

# ── MariaDB ──────────────────────────────────────────────────────────────────
# La base se llama siempre medicontrol_local (fijo en compose.yaml). Es nueva e independiente:
# no es medicontrol_db, medicontrol_test ni medicontrol_demo.

# Usuario con el que el backend se conecta a esa base (solo tiene permisos sobre ella)
MARIADB_USER=medicontrol

# OBLIGATORIA: contraseña de ese usuario
MARIADB_PASSWORD=

# OBLIGATORIA: contraseña del administrador (root) de MariaDB. La aplicación no la usa.
MARIADB_ROOT_PASSWORD=

# Importante: estas variables de MariaDB solo se aplican la PRIMERA vez, cuando el
# volumen de datos está vacío. Si después las cambiás, MariaDB sigue con las anteriores
# (ver "Volumen con datos anteriores" en docs/instalacion-docker.md).

# ── Backend (NestJS) ─────────────────────────────────────────────────────────
# OBLIGATORIA: secreto para firmar la cookie de sesión. Al menos 32 caracteres al azar.
SESSION_SECRET=

# Minutos sin actividad hasta que vence la sesión (igual que la versión PHP: 24)
SESSION_INACTIVIDAD_MINUTOS=24

# El backend recibe el resto de su configuración desde compose.yaml: se conecta a MariaDB
# por la red interna (host "mariadb", puerto 3306) y no se publica fuera de Docker.

# ── Frontend (React + Nginx) ─────────────────────────────────────────────────
# Puerto de la computadora donde se abre MediControl: http://localhost:8080
# Cambialo (por ejemplo a 8081) si el 8080 ya está ocupado.
FRONTEND_PUERTO=8080
