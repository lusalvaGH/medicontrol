# MEDICONTROL - Backend NestJS. Copiá este archivo como .env y completá los valores de tu equipo.
# El .env no se sube al repositorio.

# Servidor HTTP
PORT=3000
HOST=127.0.0.1

# Conexión a MariaDB (independiente de la configuración de la versión PHP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medicontrol_test
DB_USER=
DB_PASSWORD=

# Sesiones: secreto de al menos 32 caracteres al azar para firmar la cookie. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Minutos sin actividad hasta que vence la sesión (igual que PHP: 24)
SESSION_INACTIVIDAD_MINUTOS=24
# Cookie Secure: auto (solo con HTTPS), true o false
COOKIE_SECURE=auto
# true solo detrás de un proxy propio (por ejemplo Nginx en Docker)
TRUST_PROXY=false

# Solo para cargar la base medicontrol_demo con scripts/sembrar-demo.mjs: contraseña de las
# cuentas ficticias (8 a 72 caracteres, con letras y números). No se usa en la aplicación.
DEMO_CLAVE=
