{
  "name": "medicontrol-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MEDICONTROL - API REST en NestJS (migración desde PHP)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migraciones": "node dist/migraciones/cli.js",
    "migraciones:aplicar": "node dist/migraciones/cli.js --aplicar",
    "preparar-base": "node dist/migraciones/preparar-base.js",
    "importar-php": "node dist/importacion/cli.js"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": "(test|src)/.*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "bcryptjs": "3.0.3",
    "express-session": "1.19.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
